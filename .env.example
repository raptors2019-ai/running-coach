# =============================================================================
# This app has TWO separate environments. Putting a variable in the wrong one
# fails silently — the code just sees `undefined`.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. NEXT.JS  →  copy this file to `.env.local` (git-ignored, stays on your machine)
# -----------------------------------------------------------------------------
# Read at build time and in the browser. `npx convex dev` writes the first two
# for you the first time it runs, so you normally only fill in the Strava ID.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Strava OAuth client ID. Public by design (it appears in the authorize URL).
NEXT_PUBLIC_STRAVA_CLIENT_ID=

# NOTE: NEXT_PUBLIC_CONVEX_URL must ALSO be set in the Vercel project, for both
# the Production and Preview environments. A missing Preview value is what makes
# preview deploys fail while production is fine.


# -----------------------------------------------------------------------------
# 2. CONVEX  →  do NOT put these in .env.local; they will not be read.
# -----------------------------------------------------------------------------
# Convex functions run on Convex's servers and read their own environment.
# Set each one with:
#
#     npx convex env set NAME value
#
# or in the dashboard: dashboard.convex.dev → your project → Settings →
# Environment Variables. List what's currently set with `npx convex env list`.

# Powers the Coach tab (daily briefing + chat) and the Splits tab (reading
# split screenshots). From console.anthropic.com.
# Read implicitly by `new Anthropic()` — the name must match exactly.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Gates the Coach and Splits actions, since the app is public with no login.
# Optional — defaults to "Oakville5k" if unset.
COACH_PASSCODE=Oakville5k

# Strava activity sync.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Weather widget and workout optimizer. From openweathermap.org.
OPENWEATHERMAP_API_KEY=
